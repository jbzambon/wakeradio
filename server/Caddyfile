# Wake Radio front door.
#
# Caddy gets and renews the HTTPS certificate for {$DOMAIN} on its own.
# Every request must pass Google sign-in (oauth2-proxy) except the two
# upload endpoints, which Rdio Scanner protects with its own API key so
# SDRTrunk can post calls without a browser login.

{
	email {$ACME_EMAIL}
}

{$SITE_ADDRESS} {
	# Calls from SDRTrunk (and trunk-recorder, if ever used). API key checked by Rdio.
	@upload path /api/call-upload /api/trunk-recorder-call-upload
	handle @upload {
		request_body {
			max_size 25MB
		}
		reverse_proxy rdio-scanner:3000
	}

	# Public privacy page (Google requires a privacy policy link to publish the sign-in app).
	handle /privacy {
		header Content-Type "text/html; charset=utf-8"
		respond <<HTML
			<!doctype html>
			<html lang="en"><head><meta charset="utf-8">
			<meta name="viewport" content="width=device-width, initial-scale=1">
			<title>Wake Radio privacy</title>
			<style>body{font:16px/1.5 system-ui,sans-serif;max-width:40rem;margin:2rem auto;padding:0 1rem;color:#222}</style>
			</head><body>
			<h1>Wake Radio privacy</h1>
			<p>Wake Radio is a private, invitation-only site run by Joe Zambon for a small group of listeners.</p>
			<p><b>What we receive.</b> When you sign in with Google, the site receives your name and email address. Nothing else from your Google account is requested or accessed.</p>
			<p><b>How it is used.</b> Your email address is checked against the list of invited listeners. The site keeps a sign-in cookie in your browser so you stay signed in, and the server logs sign-ins (email address, time, IP address) for security. Logs are kept for a limited time and are not shared.</p>
			<p><b>What we don't do.</b> No advertising, no analytics, no selling or sharing of data with anyone.</p>
			<p><b>Removal.</b> Ask to be removed from the listener list at any time and your access ends immediately.</p>
			<p>Contact: {$ADMIN_EMAIL}</p>
			</body></html>
			HTML 200
	}

	# Google sign-in flow pages.
	handle /oauth2/* {
		reverse_proxy oauth2-proxy:4180 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Uri {uri}
		}
	}

	# Everything else: signed-in, allowlisted Google accounts only.
	handle {
		route {
			forward_auth oauth2-proxy:4180 {
				uri /oauth2/auth
				header_up X-Real-IP {remote_host}
				copy_headers X-Auth-Request-Email
				@signin status 401
				handle_response @signin {
					redir * /oauth2/sign_in?rd={scheme}://{host}{uri}
				}
			}

			# The Rdio admin pages are further limited to the owner's Google account.
			@notadmin {
				path /admin /admin/* /api/admin/*
				not header X-Auth-Request-Email {$ADMIN_EMAIL}
			}
			respond @notadmin "Admin only" 403

			reverse_proxy rdio-scanner:3000
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		-Server
	}

	log {
		output stdout
		format console
	}
}
